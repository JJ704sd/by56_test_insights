{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qualityctl.dev/schemas/v1/change-evidence-report.schema.json",
  "title": "Change Evidence Report v1.0",
  "type": "object",
  "additionalProperties": true,
  "required": ["contract", "status", "code", "errors", "formal_release_effect", "formal_release_allowed", "decision_digest"],
  "properties": {
    "contract": { "const": "change-evidence-report@1.0" },
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["ELIGIBLE", "EXCLUDED", "BLOCKED", "STOP_TRIGGERED"] },
    "code": { "type": "string", "minLength": 1 },
    "errors": { "type": "array", "items": { "type": "string" } },
    "formal_release_effect": { "const": "NONE" },
    "formal_release_allowed": { "const": false },
    "decision_digest": { "type": "string", "minLength": 1 }
  }
}
