{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qualityctl.dev/schemas/v1/agent_spec.schema.json",
  "title": "Quality Gatekeeper Agent Spec v1.0",
  "description": "Frozen Agent evaluation spec consumed by evaluate_agent_evidence. Mirrored by qualityctl.validation.AgentSpecV1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_version",
    "dataset_version",
    "evaluation_fingerprint",
    "execution_profile",
    "threshold_profile",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "agent_version": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "evaluation_fingerprint": { "type": "string", "minLength": 1 },
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_version",
        "model_id",
        "model_parameters",
        "toolset_version",
        "knowledge_snapshot",
        "runner_version"
      ],
      "properties": {
        "prompt_version": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_parameters": { "type": "object" },
        "toolset_version": { "type": "string", "minLength": 1 },
        "knowledge_snapshot": { "type": "string", "minLength": 1 },
        "runner_version": { "type": "string", "minLength": 1 }
      }
    },
    "threshold_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_ref", "approval_status"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "approval_status": {
          "type": "string",
          "enum": ["APPROVED", "UNAPPROVED"]
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case_entry" }
    }
  },
  "$defs": {
    "case_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "risk",
        "planned_runs",
        "min_pass_rate",
        "assertions"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "risk": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "planned_runs": { "type": "integer", "exclusiveMinimum": 0 },
        "min_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "hard_fail_on_any": { "type": "boolean" },
        "semantic_review_required": { "type": "boolean" },
        "baseline_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion_entry" }
        }
      }
    },
    "assertion_entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "paths"],
          "properties": {
            "type": { "const": "required" },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "expected"],
          "properties": {
            "type": { "const": "equals" },
            "path": { "type": "string", "minLength": 1 },
            "expected": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "values"],
          "properties": {
            "type": { "const": "one_of" },
            "path": { "type": "string", "minLength": 1 },
            "values": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "pattern"],
          "properties": {
            "type": { "const": "matches" },
            "path": { "type": "string", "minLength": 1 },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "expected"],
          "properties": {
            "type": { "const": "number" },
            "path": { "type": "string", "minLength": 1 },
            "expected": { "type": "number" },
            "absolute_tolerance": { "type": "number", "minimum": 0 },
            "relative_tolerance": { "type": "number", "minimum": 0 }
          },
          "oneOf": [
            { "required": ["absolute_tolerance"] },
            { "required": ["relative_tolerance"] }
          ]
        }
      ]
    }
  }
}
