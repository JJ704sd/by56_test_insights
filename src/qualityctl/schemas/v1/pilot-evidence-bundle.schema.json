{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qualityctl.dev/schemas/v1/pilot-evidence-bundle.schema.json",
  "title": "Pilot Evidence Bundle v1.0",
  "description": "Append-only Round 2 evidence wrapper. It references raw v1 inputs and never grants formal release effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "identity",
    "versions",
    "freeze",
    "tool_runs",
    "ordering",
    "attempts",
    "attestations",
    "catalog_readiness",
    "raw"
  ],
  "properties": {
    "contract": { "const": "pilot-evidence-bundle@1.0" },
    "schema_version": { "const": "1.0" },
    "mode": { "type": "string", "minLength": 1 },
    "evidence_mode": { "type": "string", "minLength": 1 },
    "pilot_state": { "type": "string", "minLength": 1 },
    "g0_status": { "type": "string", "minLength": 1 },
    "g0_gate": { "type": "string", "minLength": 1 },
    "evidence_origin": { "type": "string", "minLength": 1 },
    "is_fixture": { "type": "boolean" },
    "activation": { "type": ["object", "null"] },
    "evidence_overwritten": { "type": "boolean" },
    "unauthorized_release": { "type": "boolean" },
    "identity": { "$ref": "#/$defs/identity" },
    "versions": { "$ref": "#/$defs/versions" },
    "freeze": { "$ref": "#/$defs/freeze" },
    "manual_scope": { "oneOf": [{ "type": "object" }, { "type": "array" }, { "type": "null" }] },
    "tool_runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool_run" }
    },
    "ordering": { "$ref": "#/$defs/ordering" },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "attestations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/attestation" }
    },
    "catalog_readiness": { "type": "object" },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "adjudication": { "type": ["object", "null"] },
    "adjudication_ref": { "type": "string", "minLength": 1 },
    "raw": { "$ref": "#/$defs/raw" },
    "inputs": { "type": ["object", "null"] },
    "formal_release_effect": { "const": "NONE" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "size", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "digest": { "type": "string", "minLength": 1 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pilot_id", "iteration_id", "change_id", "run_id", "change_ref", "version_type"],
      "properties": {
        "pilot_id": { "type": "string", "minLength": 1 },
        "iteration_id": { "type": "string", "minLength": 1 },
        "change_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "change_ref": { "type": "string", "minLength": 1 },
        "version_type": { "enum": ["daily", "hotfix", "major"] }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "input_schema_versions", "catalog_version", "mapping_version", "policy_version"],
      "properties": {
        "core_version": { "type": "string", "minLength": 1 },
        "core_commit": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "minLength": 1 },
        "input_schema_versions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "catalog_version": { "type": "string", "minLength": 1 },
        "mapping_version": { "type": "string", "minLength": 1 },
        "policy_version": { "type": "string", "minLength": 1 },
        "agent_fingerprint_version": { "type": "string", "minLength": 1 },
        "agent_fingerprint": { "type": "string", "minLength": 1 },
        "agent_spec_digest": { "type": "string", "minLength": 1 },
        "frozen_agent_digest": { "type": "string", "minLength": 1 },
        "agent_fingerprint_digest": { "type": "string", "minLength": 1 }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_ref", "scope_digest", "owner", "manual_frozen_at"],
      "properties": {
        "scope_ref": { "type": "string", "minLength": 1 },
        "scope_digest": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "manual_frozen_at": { "type": "string", "minLength": 1 }
      }
    },
    "tool_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "exit_code", "started_at", "ended_at", "ref", "digest"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "request_ref": { "type": "string", "minLength": 1 },
        "response_ref": { "type": "string", "minLength": 1 },
        "stdout_ref": { "type": "string", "minLength": 1 },
        "stderr_ref": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "started_at": { "type": "string", "minLength": 1 },
        "ended_at": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_started_at", "tool_result_visible_at", "unblinded_at"],
      "properties": {
        "tool_started_at": { "type": "string", "minLength": 1 },
        "tool_result_visible_at": { "type": "string", "minLength": 1 },
        "unblinded_at": { "type": "string", "minLength": 1 },
        "adjudicated_at": { "type": "string", "minLength": 1 }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "kind", "digest", "started_at", "ended_at", "status", "ref"],
      "properties": {
        "attempt_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "out_of_plan": { "type": "boolean" },
        "digest": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "minLength": 1 },
        "ended_at": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "initial_attempt_ref": { "type": "string", "minLength": 1 }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version", "ref", "digest"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "approved_by": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 },
        "release_effect": { "type": "string", "minLength": 1 },
        "sensitive_data": { "type": "boolean" }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "catalog"],
      "properties": {
        "manifest": { "type": "object" },
        "catalog": { "type": "object" },
        "agent_spec": { "type": ["object", "null"] },
        "agent_runs": { "type": ["array", "null"] },
        "tool_scope": { "type": ["object", "array", "null"] },
        "formal_result": { "type": ["object", "null"] }
      }
    }
  }
}
