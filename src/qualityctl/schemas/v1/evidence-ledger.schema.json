{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qualityctl.dev/schemas/v1/evidence-ledger.schema.json",
  "title": "Frozen Evidence Ledger v1.0",
  "type": "object",
  "additionalProperties": true,
  "required": ["contract", "status", "entries", "attempts", "conflicts", "formal_release_effect", "decision_digest"],
  "properties": {
    "contract": { "const": "evidence-ledger@1.0" },
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["FROZEN", "BLOCKED"] },
    "entries": { "type": "array" },
    "attempts": { "type": "array" },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "formal_release_effect": { "const": "NONE" },
    "decision_digest": { "type": "string", "minLength": 1 }
  }
}
